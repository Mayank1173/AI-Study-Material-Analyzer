# Database connection settings for the FastAPI backend.
# Copy this file to .env and fill in your real values before running the app.
# Never commit a real .env file.

# SQLAlchemy connection URL (PostgreSQL + psycopg driver).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Example placeholder (not a real credential):
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/ai_study_analyzer

# Optional separate PostgreSQL database used only by the backend integration
# tests (tests/test_postgres_integration.py). When unset, those tests skip.
# Never point this at a production database.
# Example placeholder:
# TEST_DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/ai_study_material_analyzer_test

# Local directory where uploaded study-material files are stored.
# This directory is ignored by Git and must never hold real credentials.
# Example placeholder:
STORAGE_DIR=./storage

# Maximum allowed upload size in megabytes.
# Example placeholder:
MAX_UPLOAD_SIZE_MB=20

# Secret used to sign JWT access tokens.
# Generate a strong random value for real environments, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Example placeholder (not a real secret):
JWT_SECRET_KEY=change-me-in-production

# Algorithm used to sign/verify JWT tokens.
# Example placeholder:
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes.
# Example placeholder:
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of browser origins allowed to call this API (CORS).
# Development defaults cover the local Vite/React dev server. Never use "*"
# together with credentials in production; keep this list explicit.
# Example placeholder:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider configuration for the RAG answer engine.
# Currently supports "ollama" (local Ollama server).
# Example placeholder:
LLM_PROVIDER=ollama

# Model name used by the LLM provider.
# Example placeholder:
LLM_MODEL=qwen2.5-coder:7b

# Extended thinking/reasoning control for thinking-capable (Qwen3-class)
# models. The default qwen2.5-coder:7b model answers directly and does not use
# it; kept as "false" for backward compatibility. Set to "true" to allow longer
# reasoning when LLM_MODEL points at a thinking-capable model (also increases
# latency).
# Example placeholder:
LLM_THINK=false

# Timeout in seconds for LLM generation requests (local-development default).
# Example placeholder:
LLM_TIMEOUT_SECONDS=120

# Maximum number of tokens generated for a normal /api/chat answer. This is a
# budget ceiling (concise grounded answers finish well below it) that keeps
# local-model latency predictable when the model is under resource pressure.
# Study summaries use their own larger budget and are unaffected.
# Example placeholder:
LLM_MAX_TOKENS=512

# Base URL for the Ollama HTTP API.
# Example placeholder:
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# LLM provider settings (used by /api/chat)
# ---------------------------------------------------------------------------
# Provider type: "ollama" (default) or "mock" (for tests).
# Example placeholder:
LLM_PROVIDER=ollama

# Model name passed to the LLM provider (e.g. Ollama model tag).
# Example placeholder:
LLM_MODEL=qwen2.5-coder:7b

# Extended thinking/reasoning control for thinking-capable (Qwen3-class)
# models. The default qwen2.5-coder:7b model answers directly and does not use
# it; kept as "false" for backward compatibility. Set to "true" to allow longer
# reasoning when LLM_MODEL points at a thinking-capable model (also increases
# latency).
# Example placeholder:
LLM_THINK=false

# Timeout in seconds for LLM generation requests (local-development default).
# Example placeholder:
LLM_TIMEOUT_SECONDS=120

# Maximum tokens for a normal /api/chat answer. Ceiling, not a target; normal
# answers finish well below it, which keeps latency bounded for a local model.
# Example placeholder:
LLM_MAX_TOKENS=512

# Base URL for the Ollama HTTP API.
# Example placeholder:
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# RAG knowledge-base / vector-store settings
# ---------------------------------------------------------------------------
# Path to the SQLite-backed vector store file. When empty, the RAG layer
# defaults to rag/rag_data/knowledge_base.db relative to the rag package.
# This file is intentionally git-ignored (never commit index blobs).
# Example placeholder:
# RAG_VECTOR_STORE_PATH=./rag_data/knowledge_base.db

# Embedding backend for the knowledge base:
#   - "auto" (default): uses sentence-transformers with the model below when it
#     is installed (all-MiniLM-L6-v2, 384-dim) and falls back to the
#     dependency-free DeterministicEmbedder (128-dim) otherwise.
#   - "deterministic": always use the deterministic offline embedder.
#   - "sentence-transformers": always require the real model backend.
# Example placeholder:
RAG_EMBEDDING_BACKEND=auto

# Model name used by the sentence-transformers backend (and the model cached
# locally by sentence-transformers on first use). No API key required.
# Example placeholder:
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# NOTE: the SQLite vector store pins an embedding dimension on first insert.
# If you switch the backend/model to a different dimension (e.g. from the
# deterministic 128-dim vectors to MiniLM 384-dim vectors) you must delete the
# local rag/rag_data/knowledge_base.db once so the store is recreated with the
# new dimension. PostgreSQL data is a separate database and is untouched.
