# Database connection settings for the FastAPI backend.
# Copy this file to .env and fill in your real values before running the app.
# Never commit a real .env file.

# SQLAlchemy connection URL (PostgreSQL + psycopg driver).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Example placeholder (not a real credential):
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/ai_study_analyzer

# Optional separate PostgreSQL database used only by the backend integration
# tests (tests/test_postgres_integration.py). When unset, those tests skip.
# Never point this at a production database.
# Example placeholder:
# TEST_DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/ai_study_material_analyzer_test

# Local directory where uploaded study-material files are stored.
# This directory is ignored by Git and must never hold real credentials.
# Example placeholder:
STORAGE_DIR=./storage

# Maximum allowed upload size in megabytes.
# Example placeholder:
MAX_UPLOAD_SIZE_MB=20

# Secret used to sign JWT access tokens.
# Generate a strong random value for real environments, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Example placeholder (not a real secret):
JWT_SECRET_KEY=change-me-in-production

# Algorithm used to sign/verify JWT tokens.
# Example placeholder:
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes.
# Example placeholder:
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of browser origins allowed to call this API (CORS).
# Development defaults cover the local Vite/React dev server. Never use "*"
# together with credentials in production; keep this list explicit.
# Example placeholder:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173